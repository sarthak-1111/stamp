# Copy to .env.local and fill in. Never commit .env.local.
# Stamp is sandbox-only: it refuses to start with PAYPAL_ENV set to anything but "sandbox".

# --- PayPal SANDBOX REST app (developer.paypal.com > Apps & Credentials > Sandbox, Payouts enabled)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Set after deploying: npm run webhook:register -- --base https://<your deployment>
PAYPAL_WEBHOOK_ID=

# --- The charity: a sandbox business account that receives every captured hold (minus PayPal's fee)
CHARITY_PAYPAL_EMAIL=
CHARITY_NAME=Demo Charity (PayPal sandbox)

# --- App
# Public URL, used for PayPal return/cancel URLs and links. On Vercel it defaults to the production URL.
APP_URL=http://localhost:3000
# Long random string. Required in production: it keys the hashes of client IPs used for rate limits (raw IPs are never stored).
SESSION_SECRET=
# Lets a scheduler call /api/cron/tick without the public rate limit. Optional locally.
CRON_SECRET=
# Minutes before a checkout that was never approved is given up on (PayPal drops unapproved orders).
ABANDON_MINUTES=120
# The 3- and 10-minute release windows on the setup page, for trying the flow. "false" hides them.
ALLOW_DEMO_WINDOWS=true

# --- Database: Postgres (for example Neon) in production. Leave empty locally to use embedded PGlite in .data/
DATABASE_URL=

# --- AI triage: any OpenAI-compatible /chat/completions endpoint. Leave AI_BASE_URL empty for rule-based triage only.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=gpt-oss:120b
AI_TIMEOUT_MS=45000
